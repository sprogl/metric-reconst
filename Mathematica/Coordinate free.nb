 "We turn off the verbose messages issued by ",
 StyleBox["ComponentValue", "Output"],
 StyleBox[".", "Input"]
}], "MathCaption",ExpressionUUID->"553e1108-cd13-4eec-88d4-58ce63a4ec2a"],

