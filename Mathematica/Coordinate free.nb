Cell["Weights of the components of the curvature spinors", "Subsubsection",ExpressionUUID->"309492b1-4305-4037-b93b-622613702e92"],

Cell["\<\
It is easy to deduce the weights of the components of the curvature spinors. \
These are their values.\
\>", "MathCaption",ExpressionUUID->"2d1984c2-3cc4-415f-ab9e-ef2eff0cf3d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"PsiCDe0Dyad", "[", "]"}]}], "^=", 
     RowBox[{"{", 
      RowBox[{"4", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"PsiCDe1Dyad", "[", "]"}]}], "^=", 
     RowBox[{"{", 
      RowBox[{"2", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"PsiCDe2Dyad", "[", "]"}]}], "^=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"PsiCDe3Dyad", "[", "]"}]}], "^=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "0"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"PsiCDe4Dyad", "[", "]"}]}], "^=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "0"}], "}"}]}]}], "}"}], ";"}]], "Input",
