   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"c4e4b9ac-f72b-491b-8b05-6df080c319a2"],

Cell[TextData[{
 "We format a number of objects according to standard conventions. Due to the \
new way of sorting definitions in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 "  6.0, we need to stop the formatting engine and start it again after \
defining these new rules."
}], "Text",
 FontWeight->"Plain",ExpressionUUID->"35632e23-37df-438c-86db-b68a15b95933"],

Cell["Stop formatting engine.", "MathCaption",ExpressionUUID->"5b5b04dc-7877-4570-93c4-78a4b344dacf"],

