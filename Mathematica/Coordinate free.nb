Cell["Relation between the spin dyad and the null tetrad", "Subsubsection",ExpressionUUID->"90d41436-9b2c-45e4-9393-d53ce1ffc2c7"],

Cell["\<\
The relation between the elements of the spinor dyad and the elements of the \
null tetrad is as follows\
\>", "MathCaption",ExpressionUUID->"6ac532a6-9973-433b-84da-fc1a99f794b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SpinDyadToNullTetrad", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"\[Sigma]", "[", 
       RowBox[{"a", ",", 
        RowBox[{"-", "A"}], ",", 
        RowBox[{"-", "A\[Dagger]"}]}], "]"}], 
      RowBox[{"o", "[", "A", "]"}], 
      RowBox[{"Dagger", "@", 
       RowBox[{"o", "[", "A", "]"}]}]}], "\[Equal]", 
     RowBox[{"lNP", "[", "a", "]"}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Sigma]", "[", 
