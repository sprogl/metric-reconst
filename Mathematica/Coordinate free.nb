Cell["\<\
From now on, each Ricci rotation coefficient will be automatically replaced \
by its value in terms of the Newman-Penrose spin coefficients.\
\>", "MathCaption",ExpressionUUID->"083ba04a-3a77-4a75-a1b1-98689f6809d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RuleToSet", "@", "ChristoffelCDePDNP"}], ";"}]], "Input",
 CellLabel->
  "In[155]:=",ExpressionUUID->"8c125b9f-06e7-4abf-a272-ce6fc5520a3b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Commutation relations", "Subsubsection",ExpressionUUID->"9e870b89-a830-4f47-9694-b48dd48019a2"],

Cell[TextData[{
 "In this subsection we calculate the commutation coefficients of the \
elements of the null tetrad in terms of the spin coefficients. This is \
achieved by calculating the brackets of the elements of the null tetrad which \
in turn requires the commutation coefficients of the null tetrad elements. \
These coeffients are the components of the tensor",
 StyleBox[" TorsionPDNP", "Output"],
 StyleBox[".", "Input"]
}], "Text",
 TextJustification->1.,
 FontWeight->"Plain",ExpressionUUID->"53d724af-5e58-49cc-be9c-36eef8a7adb0"],

Cell[TextData[{
 "The first step is the creation of a folded rule containing the independent \
components of ",
 StyleBox["TorsionPDNP", "Output"],
 " in the null tetrad."
}], "MathCaption",ExpressionUUID->"20a9189c-4d44-4451-8e3a-3cc5a831129c"],

