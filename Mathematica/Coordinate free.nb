      RowBox[{"{", 
       RowBox[{"3", ",", 
        RowBox[{"-", "NP"}]}], "}"}]}], "]"}]}], ",", 
   RowBox[{
    RowBox[{"mNP\[Dagger]", "[", "a", "]"}], "\[Equal]", 
    RowBox[{"Basis", "[", 
