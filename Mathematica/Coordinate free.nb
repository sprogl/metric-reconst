    RowBox[{"Basis", "[", 
     RowBox[{"a", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "NP"}]}], "}"}]}], "]"}]}], ",", 
   RowBox[{
