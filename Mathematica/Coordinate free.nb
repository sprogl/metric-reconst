Cell[TextData[{
 "Finally we change the ",
 StyleBox["Rule", "Output"],
 " assignment to the ",
 StyleBox["Set", "Output"],
 " assignment in the ",
 StyleBox["FoldedRule", "Output"],
 " storing all the components of the metric tensor."
}], "MathCaption",
