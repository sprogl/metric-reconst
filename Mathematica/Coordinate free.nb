     RowBox[{"{", 
      RowBox[{"3", ",", 
       RowBox[{"-", "NP"}]}], "}"}], "]"}], ",", "\"\<\[Eth]\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FormatBasis", "[", 
   RowBox[{
    RowBox[{"\[CapitalTheta]", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", 
       RowBox[{"-", "NP"}]}], "}"}], "]"}], ",", "\"\<\[Eth]'\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"xTensorFormStart", "[", "CovD", "]"}]}], "Input",
 CellLabel->
  "In[305]:=",ExpressionUUID->"8b35b401-2348-4808-a203-daa34dfb7e66"],

