Cell[CellGroupData[{

Cell["3. The GHP formalism", "Subsection",ExpressionUUID->"0a41f78d-0830-4375-93c4-6148d4537913"],

Cell[TextData[{
 StyleBox["The Geroch-Held-Penrose formalism (known as GHP formalism) is a \
particularisation of the Newman-Penrose formalism in which the spin \
coefficients are separated according to their ",
  FontWeight->"Plain"],
 StyleBox["boost ",
  FontWeight->"Plain",
  FontSlant->"Italic"],
 StyleBox["and",
  FontWeight->"Plain"],
 StyleBox[" spin weight. ",
  FontWeight->"Plain",
  FontSlant->"Italic"],
 StyleBox["Also the direcctional derivatives associated to the null tetrad \
are replaced by differential operators which behave well under boost and spin \
transformations and therefore we can speak of the boost and spin weight of \
these operators. This enables us to re-write the basic equations used in the \
Newman-Penrose formalism in terms of boost-weighted quantities only. In this \
section we show how this is accomplished in the framework of ",
  FontWeight->"Plain"],
 StyleBox["Spinors`", "Output",
  FontWeight->"Plain"],
 StyleBox[" and ",
  FontWeight->"Plain"],
 StyleBox["xCoba`", "Output",
  FontWeight->"Plain"],
 StyleBox[" . ",
  FontWeight->"Plain"]
}], "Text",
 TextJustification->1.,ExpressionUUID->"e7769ce2-0e96-444a-89b2-0966e6eb46ed"],

Cell[CellGroupData[{

Cell["Boost and spin weights", "Subsubsection",ExpressionUUID->"66be096a-6f6e-411d-bbf3-7847e23e8500"],

Cell[TextData[{
 "The GHP formalism only admits ",
 StyleBox["weighted quantities",
  FontSlant->"Italic"],
 ". In this subsection we introduce a command, called ",
 StyleBox["GHPWeightOf", "Input"],
 ", which computes the boost and spin weight of any quantity. These are \
integers which are kept in a list.  The command ",
 StyleBox["GHPWeightOf", "Input"],
 " also checks that the GHP weight of the terms of any sum all agree, \
throwing an error otherwise. "
}], "Text",
 TextJustification->1.,ExpressionUUID->"a876a5e1-f623-47b6-90e8-4eb0ebb16091"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "::", "usage"}], "=", 
   "\"\<GHPWeightOf[expr] returns the GHP boost and spin weight of any \
expression. If the expression is not weighted, then an error message is \
returned\>\""}], ";"}]], "Input",
 CellLabel->
  "In[282]:=",ExpressionUUID->"dd790b25-4b0f-4588-977c-e5a7318893fc"],

Cell["Weights of integers, rationals and complex numbers.", "MathCaption",ExpressionUUID->"a97aed32-14af-4ee3-966f-989e4e71a75d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", 
    RowBox[{"num_", "?", "IntegerQ"}], " ", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", "_Rational", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", "_Complex", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[283]:=",ExpressionUUID->"1b7b87c5-f409-4166-a662-16c1718f2ba9"],

Cell["Weights of products.", "MathCaption",ExpressionUUID->"ad237002-2fa6-43d3-985a-a568c400a507"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", "expr_Times", "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", 
     RowBox[{"GHPWeightOf", "/@", 
      RowBox[{"Level", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[286]:=",ExpressionUUID->"1bb3f9f6-523d-416a-89d5-1e6d7d20deec"],

Cell["Weights of sums", "MathCaption",ExpressionUUID->"995f8a6c-3d31-4c3c-b366-be26c29bcabc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "@", "expr_Plus"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "@", 
       RowBox[{"Union", "[", 
        RowBox[{"GHPWeightOf", "/@", 
         RowBox[{"Level", "[", 
          RowBox[{"expr", ",", "1"}], "]"}]}], "]"}]}], ">", "1"}], ",", 
     RowBox[{"Throw", "@", 
      RowBox[{"Message", "[", 
       RowBox[{"GHPWeightOf", "::", "Error"}], "]"}]}], ",", 
     RowBox[{"First", "@", 
      RowBox[{"Union", "[", 
       RowBox[{"GHPWeightOf", "/@", 
        RowBox[{"Level", "[", 
         RowBox[{"expr", ",", "1"}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "::", "Error"}], "=", 
   "\"\<Inconsistent weights on Plus expression\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[287]:=",ExpressionUUID->"0a7e8542-2438-4f7b-a281-4494bbc96416"],

Cell["Weights of powers", "MathCaption",ExpressionUUID->"279d8917-1a01-425f-93ec-5479c7236d98"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", 
    RowBox[{"expr_", "^", 
     RowBox[{"(", 
      RowBox[{"n_", "?", "IntegerQ"}], ")"}]}], "]"}], ":=", 
   RowBox[{"n", " ", 
    RowBox[{"GHPWeightOf", "@", "expr"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[289]:=",ExpressionUUID->"b0af867c-ecd6-4043-b968-0c7b350cc33b"]
}, Open  ]],

