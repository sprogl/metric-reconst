Cell[CellGroupData[{

Cell["Ricci identities in the GHP formalism", "Subsubsection",ExpressionUUID->"a7b006ae-97c4-4942-84cd-dd74415590d8"],

Cell["\<\
In this subsection we use the Newman-Penrose Ricci identities (Newman-Penrose \
equations) to find a set of equations which only contain the GHP differential \
operators and spin weighted quantities. This set of equations is known as GHP \
equations or compacted spin coefficient equations.\
\>", "Text",
 TextJustification->1.,
 FontWeight->"Plain",ExpressionUUID->"056397c2-33f4-4e18-897f-cf15a785bd87"],

Cell["These are the weighted spin coefficients.", "MathCaption",ExpressionUUID->"40d0e5fc-3de5-4bc4-9363-aed3dcc97d49"],

