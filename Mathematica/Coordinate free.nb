Cell[TextData[{
 "We need to remove this automatic commutation in our calculations.  This is \
done by setting the global variable ",
 StyleBox["$CommuteCovDsOnScalars", "Input"],
 " to ",
 StyleBox["False", "Input"],
 "."
}], "MathCaption",ExpressionUUID->"6fbb7421-1bdf-4a47-8452-abb78ad3e850"],

