Cell[CellGroupData[{

Cell["GHP differential operators", "Subsubsection",ExpressionUUID->"600d845d-640c-4c38-8d08-e78a35250ff0"],

Cell[TextData[{
 "The GHP differential operators are constructed by adding some extra terms \
to the four ",
 StyleBox["NP", "Output"],
 " direccional derivatives. The result is a set of four differential \
operators having good transformation properties under spin and boost. "
}], "Text",
 TextJustification->1.,
 FontWeight->"Plain",ExpressionUUID->"badbf6e4-1db4-49ed-a639-cb32ac27a6b1"],

Cell[TextData[{
 "The GHP differential operators can be regarded as the \"components\" of a \
certain differential operator which we define next.  This  operator is not a \
true covariant derivative but just a differential operator acting on scalars, \
 so we need to use some primitive ",
 StyleBox["xAct`", "Output"],
 " instructions in order to create it. We use the notation ",
 Cell[BoxData[
  SubscriptBox["\[CapitalTheta]", "a"]], "Output",
  CellChangeTimes->CompressedData["
1:eJxTTMoPSmVkYGDQAmIBr5bssvqXjuvqQupB9HqjOe9B9DfW+h8gmkNb/R+I
vp87dWUFkP7ld+1EFZD+sKJl3hwgzbTH7xiI9rrDoz65+aVj++9AGxDN1Rt9
FkQrXd8wYy6QduqQmrwVSO/7eTpgG5Deu82sfTuQvnFf/PshIP1rycwnz4H0
pv8FTpwtLx19X8zlsQPSy6wuxjoAabPbmze6AmmhZ56zZwLpeX5x1zcD6Tnf
RJzSWl867vCfWN8HpJ3OeclMANJCBmZzJwFpmT9qf+YCaYmVth47gHT1vsdm
x4C0x5Stj24BaZVfNfdZ2l46+phr6ugCaSuRB40RQJorio1HuuOl44ngn+Hr
gPQ3Pn2x30A691hJ5x8gLfB600m2TqC7om0S2YF0sbdKLogGAK3csIk=
   "],ExpressionUUID->"60d8ac13-670c-4b48-9c32-ee8e40a6947a"],
 " as a representation for it."
}], "MathCaption",
 TextJustification->1.,ExpressionUUID->"f4c095da-72b5-452b-9273-a88f34683968"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CovDQ", "[", "\[CapitalTheta]", "]"}], "^=", "True"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xAct`xTensor`Private`MakeLinearDerivative", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[CapitalTheta]", "[", "A_", "]"}], ",", 
      RowBox[{"\[CapitalTheta]", "[", "A", "]"}]}], "}"}], ",", "True"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymmetryGroupOfCovD", "[", "\[CapitalTheta]", "]"}], "^=", 
   RowBox[{"StrongGenSet", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
     RowBox[{"GenSet", "[", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ManifoldOfCovD", "[", "\[CapitalTheta]", "]"}], "^=", 
   RowBox[{"ManifoldOfCovD", "[", "CDe", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VBundlesOfCovD", "[", "\[CapitalTheta]", "]"}], "^=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Dagger", "[", 
    RowBox[{
     RowBox[{"\[CapitalTheta]", "[", "A_", "]"}], "[", "expr_", "]"}], "]"}], 
   "^:=", 
   RowBox[{
    RowBox[{"\[CapitalTheta]", "[", 
     RowBox[{"DaggerIndex", "[", "A", "]"}], "]"}], "[", 
    RowBox[{"Dagger", "[", "expr", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SymbolOfCovD", "[", "\[CapitalTheta]", "]"}], "^=", 
   RowBox[{"{", "\"\<\[CapitalTheta]\>\"", "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[298]:=",ExpressionUUID->"4cef1c69-ab0c-4797-928c-a95290036168"],

